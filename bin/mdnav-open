#!/usr/bin/env bash
# mdnav-open -- URL handler for mdnav:// links.
#
# Registered with the desktop (XDG on Linux, HKCU on Windows for WSL) as the
# handler for the mdnav scheme. Hands the path to the mdnav that rendered
# the link, via that instance's FIFO.
#
# The URI carries the instance -- mdnav://<instance>/<path> -- so a click
# goes back to the window it was clicked in, not to whichever mdnav started
# most recently. If that one has gone, any other live mdnav takes it, and
# failing that the file is opened the ordinary way, so a click never
# silently does nothing.
set -uo pipefail

uri="${1:-}"
[ -n "$uri" ] || exit 2

path="$(python3 - "$uri" "${MDNAV_FIFO:-}" "$(id -u)" <<'PY'
import glob
import os
import sys
import urllib.parse

uri, fifo_override, uid = sys.argv[1], sys.argv[2], sys.argv[3]

rest = uri.split("://", 1)[1] if "://" in uri else uri
instance, slash, tail = rest.partition("/")
if not slash:
    # No authority: the whole thing is the path.
    instance, tail = "", rest
path = urllib.parse.unquote("/" + tail if slash else tail)
print(path)


def deliver(fifo):
    """True if a reader took it. Opening a FIFO write-only with O_NONBLOCK
    fails with ENXIO when nobody is listening, which is exactly the test --
    and unlike timeout(1) it exists everywhere."""
    try:
        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError:
        return False
    try:
        os.write(fd, (path + "\n").encode("utf-8"))
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


candidates = []
if fifo_override:
    candidates.append(fifo_override)
if instance:
    candidates.append("/tmp/mdnav-{}-{}.fifo".format(uid, instance))
# Whoever else is listening, newest first.
others = sorted(
    glob.glob("/tmp/mdnav-{}-*.fifo".format(uid)),
    key=lambda f: os.stat(f).st_mtime,
    reverse=True,
)
candidates.extend(f for f in others if f not in candidates)

for fifo in candidates:
    if deliver(fifo):
        sys.exit(0)
sys.exit(1)
PY
)" && exit 0

[ -n "$path" ] || exit 2

# Nothing listening -- fall back to the desktop's own idea of how to open it.
if command -v wslview >/dev/null 2>&1; then
    exec wslview "$path"
elif command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$path"
elif command -v open >/dev/null 2>&1; then
    exec open "$path"
fi
exit 3
