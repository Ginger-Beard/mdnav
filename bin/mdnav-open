#!/usr/bin/env bash
# mdnav-open -- URL handler for mdnav:// links.
#
# Registered with the desktop (XDG on Linux, HKCU on Windows for WSL) as the
# handler for the mdnav scheme. Hands the path to a running mdnav via its
# FIFO; if nothing is listening, opens the file the ordinary way so a click
# never silently does nothing.
set -uo pipefail

# Must match bin/mdnav exactly, and must not depend on the environment:
# this runs from the desktop, not from the user's shell.
FIFO="${MDNAV_FIFO:-/tmp/mdnav-$(id -u).fifo}"
uri="${1:-}"
[ -n "$uri" ] || exit 2

# Decode and deliver in one step. Opening a FIFO for writing with O_NONBLOCK
# fails immediately with ENXIO when no reader has it open, which is exactly
# the test we want -- and unlike timeout(1) it exists everywhere.
delivered=0
path="$(python3 - "$uri" "$FIFO" <<'PY'
import os
import sys
import urllib.parse

uri, fifo = sys.argv[1], sys.argv[2]
path = urllib.parse.unquote(uri.split("://", 1)[1] if "://" in uri else uri)
print(path)

try:
    fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
except OSError:
    sys.exit(1)  # no reader, or no FIFO
try:
    os.write(fd, (path + "\n").encode("utf-8"))
finally:
    os.close(fd)
PY
)" && delivered=1

[ "$delivered" = 1 ] && exit 0
[ -n "$path" ] || exit 2

# Nothing listening -- fall back to the desktop's own idea of how to open it.
if command -v wslview >/dev/null 2>&1; then
    exec wslview "$path"
elif command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$path"
elif command -v open >/dev/null 2>&1; then
    exec open "$path"
fi
exit 3
