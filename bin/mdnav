#!/usr/bin/env bash
# mdnav -- mdcat, with links you can click.
#
# Renders Markdown with mdcat (images and all), pages it like less, and
# stays running so that clicking a link to another local file re-renders it
# in the same pane instead of handing it to some other application.
#
# See README.md for how the click round-trip works.
set -uo pipefail

VERSION=0.2.0
MDCAT="${MDCAT_BIN:-mdcat}"
SCHEME="${MDNAV_SCHEME:-mdnav}"
# Deliberately not under XDG_RUNTIME_DIR: the handler is launched by the
# desktop (via wsl.exe on WSL) and need not share this shell's environment.
# Both ends must derive the same path with no environment involved.
FIFO="${MDNAV_FIFO:-/tmp/mdnav-$(id -u).fifo}"

# Neither `readlink -f` nor `realpath` exists everywhere (BSD/macOS), and
# python3 is already required.
abspath() { python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; }
here="$(cd "$(dirname "$(abspath "${BASH_SOURCE[0]}")")" && pwd)"
LIB="$here/../lib"

die() { printf 'mdnav: %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<EOF
mdnav $VERSION -- mdcat, with links you can click.

usage: mdnav [options] <file.md>

  -c, --cat      render once and exit, unpaged (like mdcat)
  -h, --help     this text
  -V, --version  print version

keys, while viewing:
  space, PgDn    next page              b, PgUp   previous page
  down, j        forward a line          up, k     back a line
  g, G           top, end                r         reload
  click          follow a link           l         list links, pick by number
  backspace      back to previous file   q         quit
EOF
}

cat_mode=0
file=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c|--cat) cat_mode=1 ;;
        -h|--help) usage; exit 0 ;;
        -V|--version) echo "mdnav $VERSION"; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) file="$1" ;;
    esac
    shift
done

[ -n "$file" ] || { usage >&2; exit 2; }
[ -f "$file" ] || die "no such file: $file"
command -v "$MDCAT" >/dev/null 2>&1 || die "mdcat not found (set MDCAT_BIN to override)"
command -v python3 >/dev/null 2>&1 || die "python3 is required"
for helper in mdnav_rewrite.py mdnav_detect.sh mdnav_pager.sh mdnav_keys.sh; do
    [ -f "$LIB/$helper" ] || die "missing helper: $LIB/$helper"
done
# shellcheck source=lib/mdnav_detect.sh
. "$LIB/mdnav_detect.sh"
# shellcheck source=lib/mdnav_pager.sh
. "$LIB/mdnav_pager.sh"
# shellcheck source=lib/mdnav_keys.sh
. "$LIB/mdnav_keys.sh"

# Probed once: the query costs a terminal round trip.
IMAGE_PROTOCOL="$(mdnav_image_protocol)"

current="$(abspath "$file")"
declare -a stack=()
declare -a BUFFER_LINES=()
declare -a tops=()
top=0
PAGE_NEXT=0
rows=24
cols=80

work="$(mktemp -d)"
owns_fifo=0
stty_saved=""
alt_screen=0
cleanup() {
    [ "$alt_screen" = 1 ] && printf '\e[?1007l\e[?1049l'
    rm -rf "$work"
    [ "$owns_fifo" = 1 ] && rm -f "$FIFO"
    printf '\e[?25h'
    [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null
}
trap cleanup EXIT INT TERM

# Keys are read one at a time while polling, so the terminal must not echo
# them itself -- read -s only covers its own call, leaving every keystroke
# during the FIFO poll to land on screen.
raw_mode()    { stty -echo -icanon 2>/dev/null; }
cooked_mode() { [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null; }

rewrite() {
    python3 "$LIB/mdnav_rewrite.py" "$current" "$work/render.md" "$work/links.json" "$SCHEME" \
        || die "rewrite failed"
}

link_count() { python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$work/links.json" 2>/dev/null || echo 0; }
link_path()  { python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));i=int(sys.argv[2])-1;print(d[i]["path"] if 0<=i<len(d) else "")' "$work/links.json" "$1" 2>/dev/null; }

list_links() {
    python3 - "$work/links.json" <<'PY'
import json, sys
try:
    links = json.load(open(sys.argv[1]))
except Exception:
    links = []
if not links:
    print("  (no local links in this file)")
for i, l in enumerate(links, 1):
    print("  {:>2}) {}".format(i, l["label"]))
PY
}

# Render the whole document once into a buffer we page over. --ansi is
# required because the output is redirected: without it mdcat decides it is
# not talking to a terminal and drops colour and images.
load_buffer() {
    rewrite
    cols="$(tput cols 2>/dev/null || echo 80)"
    rows="$(tput lines 2>/dev/null || echo 24)"
    local args=(--ansi --columns "$cols")
    [ -n "$IMAGE_PROTOCOL" ] && args+=(--image-protocol "$IMAGE_PROTOCOL")
    "$MDCAT" "${args[@]}" "$work/render.md" > "$work/buffer.ansi" 2>/dev/null \
        || "$MDCAT" --ansi --columns "$cols" "$work/render.md" > "$work/buffer.ansi"

    BUFFER_LINES=()
    while IFS= read -r bufline; do
        BUFFER_LINES+=("$bufline")
    done < "$work/buffer.ansi"
    top=0
    tops=()
}

goto() {
    local target="$1"
    [ -n "$target" ] || return 1
    [ -f "$target" ] || return 1
    case "$target" in
        *.md|*.markdown|*.mkd) ;;
        *)  # Not markdown -- hand it to the desktop rather than render it.
            if command -v wslview >/dev/null 2>&1; then wslview "$target"
            elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$target" >/dev/null 2>&1
            elif command -v open >/dev/null 2>&1; then open "$target" >/dev/null 2>&1
            fi
            return 1 ;;
    esac
    stack+=("$current")
    current="$target"
    return 0
}

status() {
    local n left right short pad pos total
    n="$(link_count)"
    total="${#BUFFER_LINES[@]}"
    if [ "$PAGE_NEXT" -ge "$total" ]; then pos="end"
    elif [ "$top" -le 0 ]; then pos="top"
    elif [ "$total" -gt 0 ]; then pos="$(( top * 100 / total ))%"
    else pos="top"
    fi

    left=" ${current##*/}  ${pos}  ${n} link(s)"
    right="click a link"
    [ ${#stack[@]} -gt 0 ] && right="$right · bksp back"
    right="$right · space/b page · l list · q quit "
    short="space/b page · l list · q quit "

    pad=$(( cols - ${#left} - ${#right} ))
    if [ "$pad" -lt 1 ]; then
        pad=$(( cols - ${#left} - ${#short} ))
        right="$short"
    fi
    if [ "$pad" -lt 1 ]; then
        printf '\e[7m%-*.*s\e[0m' "$cols" "$cols" " $right"
    else
        printf '\e[7m%s%*s%s\e[0m' "$left" "$pad" "" "$right"
    fi
}

# --cat keeps the unpaged behaviour: straight to the TTY, so it can be piped
# or used where a pager would be in the way.
if [ "$cat_mode" = 1 ]; then
    rewrite
    if [ -n "$IMAGE_PROTOCOL" ]; then
        "$MDCAT" --image-protocol "$IMAGE_PROTOCOL" "$work/render.md" && exit 0
    fi
    exec "$MDCAT" "$work/render.md"
fi

# One reader per user. A second instance takes the FIFO over; the handler
# always writes to this one path.
[ -p "$FIFO" ] && rm -f "$FIFO"
mkfifo -m 600 "$FIFO" || die "could not create $FIFO"
owns_fifo=1
# Held open read-write so reads never see EOF between clicks.
exec 3<>"$FIFO"

stty_saved="$(stty -g 2>/dev/null || true)"
raw_mode
# 1049: alternate screen, so the view starts at the top of the document
# rather than at the bottom of a scrollback dump. 1007: alternate scroll,
# so the wheel sends arrow keys -- without enabling mouse reporting, which
# would swallow the link clicks this whole thing exists for.
printf '\e[?1049h\e[?1007h'
alt_screen=1

resized=0
trap 'resized=1' WINCH

load_buffer

while :; do
    if [ "$resized" = 1 ]; then
        keep_top="$top"
        load_buffer
        top="$keep_top"
        [ "$top" -ge "${#BUFFER_LINES[@]}" ] && top=0
        resized=0
    fi

    avail=$(( rows - 1 ))
    [ "$avail" -lt 1 ] && avail=1

    printf '\e[?25l'
    mdnav_draw_page "$top" "$avail"
    printf '\e[%d;1H' "$rows"
    status

    action=""
    while [ -z "$action" ]; do
        # Already percent-decoded by mdnav-open -- decoding again would
        # corrupt any path containing a literal % sequence.
        if IFS= read -r -u 3 -t 0.15 clicked; then
            if goto "$clicked"; then action=nav; fi
            continue
        fi

        mdnav_read_key || continue
        case "$KEY" in
            space|pgdn|char:f)
                if [ "$PAGE_NEXT" -lt "${#BUFFER_LINES[@]}" ]; then
                    tops+=("$top"); top="$PAGE_NEXT"; action=redraw
                fi ;;
            pgup|char:b)
                if [ ${#tops[@]} -gt 0 ]; then
                    last=$(( ${#tops[@]} - 1 ))
                    top="${tops[$last]}"; unset "tops[$last]"
                else
                    top=$(( top - avail )); [ "$top" -lt 0 ] && top=0
                fi
                action=redraw ;;
            down|char:j)
                if [ "$PAGE_NEXT" -lt "${#BUFFER_LINES[@]}" ]; then
                    top=$(( top + 1 )); action=redraw
                fi ;;
            up|char:k)
                if [ "$top" -gt 0 ]; then top=$(( top - 1 )); action=redraw; fi ;;
            home|char:g)
                top=0; tops=(); action=redraw ;;
            end|char:G)
                top=$(( ${#BUFFER_LINES[@]} - avail ))
                [ "$top" -lt 0 ] && top=0
                tops=(); action=redraw ;;
            char:r)
                action=reload ;;
            backspace|char:H)
                if [ ${#stack[@]} -gt 0 ]; then
                    last=$(( ${#stack[@]} - 1 ))
                    current="${stack[$last]}"; unset "stack[$last]"
                    action=nav
                fi ;;
            char:l|char:L)
                printf '\e[?25h\e[H\e[2J'
                cooked_mode
                list_links
                printf '\nfollow link #: '
                IFS= read -r num
                raw_mode
                if [ -n "${num//[!0-9]/}" ] && goto "$(link_path "$num")"; then
                    action=nav
                else
                    action=redraw
                fi ;;
            char:q|char:Q)
                action=quit ;;
        esac
    done

    case "$action" in
        quit) break ;;
        nav|reload) load_buffer ;;
    esac
done
