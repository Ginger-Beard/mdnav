#!/usr/bin/env bash
# mdnav -- mdcat, with links you can click.
#
# Renders Markdown with mdcat, images included, and behaves like a pager:
# opens at the top, scrolls both ways, and follows a link to another local
# file in the same pane instead of handing it to another application.
#
# Images are sliced into strips one text row tall before rendering, which
# is what makes the rest possible: every line in the buffer occupies
# exactly one screen row, so the window arithmetic is exact and a
# half-scrolled image is simply the strips that fall inside it.
set -uo pipefail

VERSION=0.4.0
MDCAT="${MDCAT_BIN:-mdcat}"
SCHEME="${MDNAV_SCHEME:-mdnav}"
FIFO="${MDNAV_FIFO:-/tmp/mdnav-$(id -u).fifo}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/mdnav"

abspath() { python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; }
here="$(cd "$(dirname "$(abspath "${BASH_SOURCE[0]}")")" && pwd)"
LIB="$here/../lib"

die() { printf 'mdnav: %s\n' "$*" >&2; exit 1; }

if [ -n "${MDNAV_DEBUG:-}" ]; then
    exec 4>>"$MDNAV_DEBUG"
    BASH_XTRACEFD=4
    set -x
fi

usage() {
    cat <<EOF
mdnav $VERSION -- mdcat, with links you can click.

usage: mdnav [options] <file.md>

  -c, --cat      render once to stdout and exit (like mdcat)
  -h, --help     this text
  -V, --version  print version

keys:
  up/down, k/j, wheel    scroll a line
  space/PgDn, b/PgUp     scroll a page
  g / G                  top / bottom
  ctrl+click             follow a link
  l                      list links, pick one by number
  backspace              back to the previous file
  r                      reload
  q                      quit
EOF
}

cat_mode=0
file=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c|--cat) cat_mode=1 ;;
        -h|--help) usage; exit 0 ;;
        -V|--version) echo "mdnav $VERSION"; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) file="$1" ;;
    esac
    shift
done

[ -n "$file" ] || { usage >&2; exit 2; }
[ -f "$file" ] || die "no such file: $file"
command -v "$MDCAT" >/dev/null 2>&1 || die "mdcat not found (set MDCAT_BIN to override)"
command -v python3 >/dev/null 2>&1 || die "python3 is required"
for helper in mdnav_rewrite.py mdnav_detect.sh mdnav_keys.sh mdnav_slice.py; do
    [ -f "$LIB/$helper" ] || die "missing helper: $LIB/$helper"
done
# shellcheck source=lib/mdnav_detect.sh
. "$LIB/mdnav_detect.sh"
# shellcheck source=lib/mdnav_keys.sh
. "$LIB/mdnav_keys.sh"

IMAGE_PROTOCOL="$(mdnav_image_protocol)"
# Slicing needs a cropper. Without one, images stay whole and mdcat draws
# them -- everything still works, but a tall image jumps rather than
# scrolling, because it is one indivisible escape again.
SLICE=0
if command -v convert >/dev/null 2>&1 && [ "$IMAGE_PROTOCOL" = "sixel" ]; then
    SLICE=1
fi

current="$(abspath "$file")"
declare -a stack=()
declare -a BUF=()
LINK_COUNT=0
top=0
rows=24
cols=80
cell_w=10
cell_h=20

work="$(mktemp -d)"
owns_fifo=0
stty_saved=""
alt=0
cleanup() {
    if [ "$alt" = 1 ]; then
        printf '\e[?1007l\e[?1049l'
    fi
    rm -rf "$work"
    [ "$owns_fifo" = 1 ] && rm -f "$FIFO"
    printf '\e[?25h'
    [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

raw_mode()    { stty -echo -icanon 2>/dev/null; }
cooked_mode() { [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null; }

# Cell size in pixels, so images can be sliced to exactly one row each.
query_cell_size() {
    local saved reply h w
    saved="$(stty -g 2>/dev/null)" || return
    stty -echo -icanon 2>/dev/null
    printf '\e[16t' > /dev/tty 2>/dev/null
    IFS= read -r -d t -t 0.4 reply < /dev/tty 2>/dev/null
    stty "$saved" 2>/dev/null
    h="${reply##*\[6;}"; h="${h%%;*}"
    w="${reply##*;}"
    case "$h" in ''|*[!0-9]*) return ;; esac
    case "$w" in ''|*[!0-9]*) return ;; esac
    cell_h="$h"
    cell_w="$w"
}

rewrite() {
    local mode=inline
    [ "$SLICE" = 1 ] && mode=marker
    python3 "$LIB/mdnav_rewrite.py" "$current" "$work/render.md" "$work/links.json" \
        "$SCHEME" "$mode" "$work/images.json" || die "rewrite failed"
}

link_count() { python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$work/links.json" 2>/dev/null || echo 0; }
link_path()  { python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));i=int(sys.argv[2])-1;print(d[i]["path"] if 0<=i<len(d) else "")' "$work/links.json" "$1" 2>/dev/null; }
image_path() { python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));i=int(sys.argv[2]);print(d[i] if 0<=i<len(d) else "")' "$work/images.json" "$1" 2>/dev/null; }

list_links() {
    python3 - "$work/links.json" <<'PY'
import json, sys
try:
    links = json.load(open(sys.argv[1]))
except Exception:
    links = []
if not links:
    print("  (no local links in this file)")
for i, l in enumerate(links, 1):
    print("  {:>2}) {}".format(i, l["label"]))
PY
}

load_buffer() {
    rewrite
    cols="$(tput cols 2>/dev/null || echo 80)"
    rows="$(tput lines 2>/dev/null || echo 24)"

    local args=(--ansi --columns "$cols")
    [ -n "$IMAGE_PROTOCOL" ] && [ "$SLICE" = 0 ] && args+=(--image-protocol "$IMAGE_PROTOCOL")
    "$MDCAT" "${args[@]}" "$work/render.md" > "$work/buffer.ansi" 2>/dev/null \
        || "$MDCAT" --ansi --columns "$cols" "$work/render.md" > "$work/buffer.ansi"

    BUF=()
    local line idx img strips
    while IFS= read -r line; do
        case "$line" in
            *MDNAVIMG:*)
                idx="${line#*MDNAVIMG:}"; idx="${idx%%:*}"; idx="${idx//[!0-9]/}"
                img="$(image_path "$idx")"
                strips=""
                [ -n "$img" ] && [ -f "$img" ] && \
                    strips="$(python3 "$LIB/mdnav_slice.py" "$img" "$cell_w" "$cell_h" "$cols" "$CACHE" 2>/dev/null)"
                if [ -n "$strips" ] && [ -f "$strips" ]; then
                    while IFS= read -r strip; do
                        BUF+=("$strip")
                    done < "$strips"
                else
                    BUF+=("[image]")
                fi ;;
            *) BUF+=("$line") ;;
        esac
    done < "$work/buffer.ansi"

    local junk
    while IFS= read -rsn1 -t 0.05 junk; do :; done
    LINK_COUNT="$(link_count)"
    top=0
}

goto() {
    local target="$1"
    [ -n "$target" ] || return 1
    [ -f "$target" ] || return 1
    case "$target" in
        *.md|*.markdown|*.mkd) ;;
        *)  if command -v wslview >/dev/null 2>&1; then wslview "$target"
            elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$target" >/dev/null 2>&1
            elif command -v open >/dev/null 2>&1; then open "$target" >/dev/null 2>&1
            fi
            return 1 ;;
    esac
    stack+=("$current")
    current="$target"
    return 0
}

view_rows() { echo $(( rows - 1 )); }

max_top() {
    local avail; avail="$(view_rows)"
    local m=$(( ${#BUF[@]} - avail ))
    [ "$m" -lt 0 ] && m=0
    echo "$m"
}

draw_line() {   # <screen row> <buffer index>
    local srow="$1" i="$2"
    printf '\e[%d;1H\e[K' "$srow"
    [ "$i" -lt "${#BUF[@]}" ] && printf '%s' "${BUF[$i]}"
}

draw_all() {
    local avail; avail="$(view_rows)"
    local r=1
    printf '\e[H\e[2J'
    while [ "$r" -le "$avail" ]; do
        draw_line "$r" $(( top + r - 1 ))
        r=$(( r + 1 ))
    done
}

# Every movement repaints. Scrolling the region instead would be cheaper,
# but the terminal moves the text cells and leaves the sixel pixels where
# they were, so images tore into stripes as soon as anything scrolled. A
# full repaint of a screenful of strips measures around 15ms, which is well
# inside the budget for it not to matter.
status() {
    local n pos total avail left right pad
    n="$LINK_COUNT"
    total="${#BUF[@]}"
    avail=$(( rows - 1 ))
    if [ "$total" -le "$avail" ]; then pos="all"
    elif [ "$top" -le 0 ]; then pos="top"
    elif [ "$top" -ge "$(max_top)" ]; then pos="end"
    else pos="$(( top * 100 / (total - avail) ))%"
    fi

    left=" ${current##*/}  ${pos}  ${n} link(s)"
    right="ctrl+click a link"
    [ ${#stack[@]} -gt 0 ] && right="$right · bksp back"
    right="$right · l list · q quit "
    pad=$(( cols - ${#left} - ${#right} ))
    printf '\e[%d;1H\e[K' "$rows"
    if [ "$pad" -lt 1 ]; then
        printf '\e[7m%-*.*s\e[0m' "$cols" "$cols" " $right"
    else
        printf '\e[7m%s%*s%s\e[0m' "$left" "$pad" "" "$right"
    fi
}

if [ "$cat_mode" = 1 ]; then
    SLICE=0
    rewrite
    if [ -n "$IMAGE_PROTOCOL" ]; then
        "$MDCAT" --image-protocol "$IMAGE_PROTOCOL" "$work/render.md" && exit 0
    fi
    exec "$MDCAT" "$work/render.md"
fi

[ -p "$FIFO" ] && rm -f "$FIFO"
mkfifo -m 600 "$FIFO" || die "could not create $FIFO"
owns_fifo=1
exec 3<>"$FIFO"

stty_saved="$(stty -g 2>/dev/null || true)"
raw_mode
query_cell_size

# 1049: own the screen, so the view can start at the top and stay put.
# 8452: leave the cursor beside a sixel rather than below it, so a strip
#       occupies its row and nothing else.
# 1007: the wheel arrives as arrow keys -- no mouse reporting, so the
#       terminal goes on handling ctrl+click on hyperlinks itself.
printf '\e[?1049h\e[?8452h\e[?1007h'
alt=1
printf '\e[?25l'

resized=0
trap 'resized=1' WINCH

load_buffer
draw_all
status

while :; do
    if [ "$resized" = 1 ]; then
        resized=0
        keep="$top"
        load_buffer
        top="$keep"
        [ "$top" -gt "$(max_top)" ] && top="$(max_top)"
        draw_all
        status
        continue
    fi

    if read -t 0 -u 3 2>/dev/null && IFS= read -r -u 3 clicked; then
        if goto "$clicked"; then
            load_buffer
            draw_all
            status
        fi
        continue
    fi

    mdnav_read_key || continue
    avail="$(view_rows)"
    mt="$(max_top)"

    case "$KEY" in
        down|char:j)
            if [ "$top" -lt "$mt" ]; then top=$(( top + 1 )); draw_all; status; fi ;;
        up|char:k)
            if [ "$top" -gt 0 ]; then top=$(( top - 1 )); draw_all; status; fi ;;
        space|pgdn|char:f)
            if [ "$top" -lt "$mt" ]; then
                top=$(( top + avail )); [ "$top" -gt "$mt" ] && top="$mt"
                draw_all; status
            fi ;;
        pgup|char:b)
            if [ "$top" -gt 0 ]; then
                top=$(( top - avail )); [ "$top" -lt 0 ] && top=0
                draw_all; status
            fi ;;
        home|char:g)
            if [ "$top" -ne 0 ]; then top=0; draw_all; status; fi ;;
        end|char:G)
            if [ "$top" -ne "$mt" ]; then top="$mt"; draw_all; status; fi ;;
        char:r)
            load_buffer; draw_all; status ;;
        backspace|char:H)
            if [ ${#stack[@]} -gt 0 ]; then
                last=$(( ${#stack[@]} - 1 ))
                current="${stack[$last]}"; unset "stack[$last]"
                load_buffer; draw_all; status
            fi ;;
        char:l|char:L)
            printf '\e[H\e[2J\e[?25h'
            cooked_mode
            list_links
            printf '\nfollow link #: '
            IFS= read -r num
            raw_mode
            printf '\e[?25l'
            if [ -n "${num//[!0-9]/}" ] && goto "$(link_path "$num")"; then
                load_buffer
            fi
            draw_all; status ;;
        char:q|char:Q)
            break ;;
    esac
done
