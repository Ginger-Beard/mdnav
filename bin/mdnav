#!/usr/bin/env bash
# mdnav -- mdcat, with links you can click.
#
# Renders Markdown with mdcat, images included, and behaves like a pager:
# opens at the top, scrolls both ways, and follows a link to another local
# file in the same pane instead of handing it to another application.
#
# Images are sliced into strips one text row tall before rendering, which
# is what makes the rest possible: every line in the buffer occupies
# exactly one screen row, so the window arithmetic is exact and a
# half-scrolled image is simply the strips that fall inside it.
set -uo pipefail

VERSION=0.4.0
MDCAT="${MDCAT_BIN:-mdcat}"
SCHEME="${MDNAV_SCHEME:-mdnav}"
# One FIFO per instance, named in the links it renders, so several mdnavs
# can run at once without stealing each other's clicks.
INSTANCE="${MDNAV_INSTANCE:-$$}"
export MDNAV_INSTANCE="$INSTANCE"
FIFO="${MDNAV_FIFO:-/tmp/mdnav-$(id -u)-$INSTANCE.fifo}"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/mdnav"

abspath() { python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$1"; }
here="$(cd "$(dirname "$(abspath "${BASH_SOURCE[0]}")")" && pwd)"
LIB="$here/../lib"

die() { printf 'mdnav: %s\n' "$*" >&2; exit 1; }

if [ -n "${MDNAV_DEBUG:-}" ]; then
    exec 4>>"$MDNAV_DEBUG"
    BASH_XTRACEFD=4
    set -x
fi

usage() {
    cat <<EOF
mdnav $VERSION -- mdcat, with links you can click.

usage: mdnav [options] <file.md>

  -c, --cat      render once to stdout and exit (like mdcat)
  -S             let long lines run off the edge instead of wrapping
  -g             highlight only the current match, not all of them
  -G             do not highlight matches at all
  -h, --help     this text
  -V, --version  print version

keys:
  up/down, k/j           scroll a line
  wheel                  scroll 3 lines (MDNAV_WHEEL_LINES)
  space/PgDn, b/u/PgUp   scroll a page
  g / G                  top / bottom
  click                  follow a link
  ctrl+click             hand the link to the desktop instead
  / ?                    search forward, backward
  n / N                  next match, previous
  esc                    clear the search
  l                      list links with their targets, pick by number
  p, backspace           back to the previous file (:p too)
  r                      reload now (it also reloads on its own when the file changes)
  Ng                     go to line N (as 50g)
  :q                     quit
  q                      quit

shift+drag selects text: mdnav holds the mouse so the wheel can scroll,
and shift is how terminals let you reach past that.
EOF
}

# What a directory is a page of: the README inside it, where there is one.
# The same rule the rewriter applies to a link, kept here as well for the
# paths that do not come through it -- the command line, and a click
# delivered by the opener.
page_for() {
    local target="$1" name
    if [ -d "$target" ]; then
        for name in README.md index.md README.markdown index.markdown; do
            if [ -f "$target/$name" ]; then
                printf '%s' "$target/$name"
                return 0
            fi
        done
    fi
    printf '%s' "$target"
}

cat_mode=0
# Long lines are wrapped, as less does; -S leaves them running off the edge.
CHOP=0
# How much of a search to mark, following less: all matches by default, only
# the current one under -g, none under -G.
HILITE=all
file=""
while [ $# -gt 0 ]; do
    case "$1" in
        -c|--cat) cat_mode=1 ;;
        -S|--chop-long-lines) CHOP=1 ;;
        -g|--hilite-search) HILITE=current ;;
        -G|--HILITE-SEARCH) HILITE=none ;;
        -h|--help) usage; exit 0 ;;
        -V|--version) echo "mdnav $VERSION"; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *) file="$1" ;;
    esac
    shift
done

[ -n "$file" ] || { usage >&2; exit 2; }
# A directory is as good a starting point as a file: it opens as the page
# inside it, or as a listing of what it holds.
[ -f "$file" ] || [ -d "$file" ] || die "no such file: $file"
command -v "$MDCAT" >/dev/null 2>&1 || die "mdcat not found (set MDCAT_BIN to override)"
command -v python3 >/dev/null 2>&1 || die "python3 is required"
for helper in mdnav_rewrite.py mdnav_detect.sh mdnav_keys.sh mdnav_slice.py \
              mdnav_spans.py mdnav_anchor.py mdnav_links.py \
              mdnav_tablelinks.py; do
    [ -f "$LIB/$helper" ] || die "missing helper: $LIB/$helper"
done
# shellcheck source=lib/mdnav_detect.sh
. "$LIB/mdnav_detect.sh"
# shellcheck source=lib/mdnav_keys.sh
. "$LIB/mdnav_keys.sh"

IMAGE_PROTOCOL="$(mdnav_image_protocol)"
# Slicing needs a cropper. Without one, images stay whole: a tall one
# jumps into view rather than scrolling into it, because it is one
# indivisible escape again. It is only that, and not a corrupted screen,
# because the pager asks an image how many rows it draws rather than
# assuming one -- an image counted short scrolls by less than it painted
# and lands the next frame on top of the last.
SLICE=0
if [ "${MDNAV_SLICE:-1}" != 0 ] && command -v convert >/dev/null 2>&1 \
   && [ "$IMAGE_PROTOCOL" = "sixel" ]; then
    SLICE=1
fi

current="$(abspath "$file")"
current="$(page_for "$current")"
declare -a stack=()
declare -a BUF=()
declare -a HLBUF=()
LINK_COUNT=0
SEARCH_PAT=""
SEARCH_DIR=1
SEARCH_MSG=""
COUNT=""
LAST_MTIME=""
WATCH_TICK=0
ANCHOR_LINE=-1
# A place in the document about to be loaded, named by the link that is
# opening it. Acted on once that document is on screen, since the heading
# belongs to it and not to the one being left.
PENDING_ANCHOR=""
ACTIVE_MATCH=-1
ACTIVE_OCC=-1
ACTIVE_RENDER=""
MATCH_POS=-1
declare -a SPAN=()
declare -a ROWLINE=()
declare -a LINKMAP=()
HOVER_URI=""
declare -a MATCH_LINE=()
declare -a MATCH_OCC=()
top=0
rows=24
cols=80
cell_w=10
cell_h=20

work="$(mktemp -d)"
owns_fifo=0
stty_saved=""
alt=0
cleanup() {
    if [ "$alt" = 1 ]; then
        printf '\e[?7h\e[?2026l\e[?1006l\e[?1003l\e[?1000l\e[?1007l\e[?1049l'
    fi
    rm -rf "$work"
    [ "$owns_fifo" = 1 ] && rm -f "$FIFO"
    printf '\e[?25h'
    [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

raw_mode()    { stty -echo -icanon 2>/dev/null; }
cooked_mode() { [ -n "$stty_saved" ] && stty "$stty_saved" 2>/dev/null; }

# Modification time, for noticing the file change underneath us. GNU and
# BSD stat disagree on the flag, so settle it once rather than per check.
STAT_FLAG=""
if stat -c %Y . >/dev/null 2>&1; then
    STAT_FLAG="-c%Y"
elif stat -f %m . >/dev/null 2>&1; then
    STAT_FLAG="-f%m"
fi
file_mtime() {
    [ -n "$STAT_FLAG" ] || return 1
    stat "$STAT_FLAG" "$current" 2>/dev/null
}

# Cell size in pixels, so images can be sliced to exactly one row each.
query_cell_size() {
    local saved reply h w
    saved="$(stty -g 2>/dev/null)" || return
    stty -echo -icanon 2>/dev/null
    printf '\e[16t' > /dev/tty 2>/dev/null
    IFS= read -r -d t -t 0.4 reply < /dev/tty 2>/dev/null
    stty "$saved" 2>/dev/null
    h="${reply##*\[6;}"; h="${h%%;*}"
    w="${reply##*;}"
    case "$h" in ''|*[!0-9]*) return ;; esac
    case "$w" in ''|*[!0-9]*) return ;; esac
    cell_h="$h"
    cell_w="$w"
}

rewrite() {
    python3 "$LIB/mdnav_rewrite.py" "$current" "$work/render.md" "$work/links.json" \
        "$SCHEME" || die "rewrite failed"
}

link_count() { python3 -c 'import json,sys;print(len(json.load(open(sys.argv[1]))))' "$work/links.json" 2>/dev/null || echo 0; }
link_path()  { python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));i=int(sys.argv[2])-1;print(d[i]["path"] if 0<=i<len(d) else "")' "$work/links.json" "$1" 2>/dev/null; }

list_links() {
    python3 - "$work/links.json" "$cols" "$current" "$work/links.json.anchors" <<'PY'
import json, os, re, sys

links_file, width, current, anchors_file = sys.argv[1:5]
width = int(width)
try:
    links = json.load(open(links_file))
except Exception:
    links = []
try:
    anchors = json.load(open(anchors_file))
except Exception:
    anchors = {}

if not links:
    print("  (no local links in this file)")
    raise SystemExit(0)

here = os.path.dirname(current)
rows = []
for link in links:
    label = " ".join(link["label"].split())
    target = link["path"]
    if target.startswith("#"):
        slug, _, item = target[1:].partition("|")
        where = anchors.get(slug, slug)
        if item:
            where += ", item " + item
        rows.append((label, where))
        continue
    # Relative to the document being read: the absolute path is the same
    # long prefix on every line and says nothing.
    if link.get("external") or re.match(r"[a-zA-Z][a-zA-Z0-9+.-]*:", target):
        # A URL is already the shortest true thing to say about itself.
        rows.append((label, target) if label != target else (target, ""))
        continue
    try:
        where = os.path.relpath(target, here)
    except ValueError:
        where = target
    # When the label is already the file, one column says everything.
    if label.lstrip("./") == where:
        rows.append((where, ""))
    else:
        rows.append((label, where))

# Only the rows that carry a target need a column to line up in; a row
# that is just a filename should not be padded to match one.
paired = [len(a) for a, w in rows if w]
label_room = min(28, max(paired)) if paired else 12

for i, (label, where) in enumerate(rows, 1):
    if not where:
        room = width - 8
        if len(label) > room:
            label = "…" + label[-(room - 1):]
        print("  {:>2}) {}".format(i, label))
        continue
    if len(label) > label_room:
        label = label[:label_room - 1] + "…"
    room = width - label_room - 12
    if room > 4 and len(where) > room:
        where = "…" + where[-(room - 1):]
    print("  {:>2}) {:<{}}  -> {}".format(i, label, label_room, where))
PY
}

# The window, in cells. Asked of the kernel first, which knows the size of
# every terminal, rather than of terminfo, which only knows terminals whose
# entry is installed here -- and a terminal too new or too local for that,
# or one named across an ssh to an older machine, makes tput fail. Falling
# back to 80x24 there is worse than it sounds: it is not a stale size but a
# wrong one, and every line is wrapped and every page measured against a
# window nobody is looking at.
term_size() {
    local size=""
    size="$(stty size 2>/dev/null < /dev/tty)" || size="$(stty size 2>/dev/null)"
    case "$size" in
        [0-9]*\ [0-9]*)
            rows="${size%% *}"
            cols="${size##* }" ;;
        *)
            cols="$(tput cols 2>/dev/null)" || cols=""
            rows="$(tput lines 2>/dev/null)" || rows=""
            [ -n "$cols" ] || cols="${COLUMNS:-80}"
            [ -n "$rows" ] || rows="${LINES:-24}" ;;
    esac
    case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
    case "$rows" in ''|*[!0-9]*) rows=24 ;; esac
    # Narrower than this and there is nothing to read; shorter and there is
    # no room for a document and a status bar both.
    [ "$cols" -lt 20 ] && cols=20
    [ "$rows" -lt 3 ] && rows=3
    return 0
}

load_buffer() {
    rewrite
    term_size

    local args=(--ansi --columns "$cols")
    [ -n "$IMAGE_PROTOCOL" ] && args+=(--image-protocol "$IMAGE_PROTOCOL")
    "$MDCAT" "${args[@]}" "$work/render.md" > "$work/buffer.ansi" 2>/dev/null \
        || "$MDCAT" --ansi --columns "$cols" "$work/render.md" > "$work/buffer.ansi"

    # Cut every image down to strips one row tall. Done on the rendered
    # output rather than the source, so it catches Mermaid diagrams and
    # rendered maths too -- mdcat draws those as images although nothing in
    # the Markdown says so.
    if [ "$SLICE" = 1 ] && \
       python3 "$LIB/mdnav_slice.py" "$work/buffer.ansi" "$work/sliced.ansi" \
           "$cell_h" "$CACHE" 2>/dev/null; then
        mv "$work/sliced.ansi" "$work/buffer.ansi"
    elif [ -n "${MDNAV_DEBUG:-}" ] && grep -q $'\x1bP' "$work/buffer.ansi" 2>/dev/null; then
        # Worth saying: an image that is not cut into strips cannot be drawn
        # a row at a time, so it appears only once the whole of it fits, and
        # the reason is nowhere on screen.
        printf 'mdnav: %s: images left whole (slicing %s, protocol %s, cropper %s)\n' \
            "${current##*/}" \
            "$([ "${MDNAV_SLICE:-1}" = 0 ] && echo "off by request" || echo on)" \
            "${IMAGE_PROTOCOL:-auto}" \
            "$(command -v convert >/dev/null 2>&1 && echo found || echo missing)" >&4
    fi

    load_lines "$work/buffer.ansi"

    # Long lines are left whole for the terminal to wrap, so that selecting
    # one copies it back unbroken -- the difference between code you can
    # paste and code you cannot. The cost is that a line is no longer a
    # row, so how many rows each takes has to be known.
    SPAN=()
    if [ "$CHOP" = 0 ]; then
        local sp i=0
        while IFS= read -r sp; do
            SPAN[$i]="$sp"
            i=$(( i + 1 ))
        done < <(python3 "$LIB/mdnav_spans.py" "$work/buffer.ansi" "$cols" \
                     "$cell_h" 2>/dev/null)
    fi

    local junk
    while IFS= read -rsn1 -t 0.05 junk; do :; done

    # mdcat keeps a link's style inside a table cell and drops its
    # destination, so a table is the one place a link stops being one.
    # What was written is known here, so what went missing is put back
    # before anything downstream looks. Nothing to do if a version turns
    # up that carries them itself.
    python3 "$LIB/mdnav_tablelinks.py" "$work/buffer.ansi" "$work/links.json" \
        2>/dev/null || :

    # Where each link sits on screen, so a mouse position can be turned
    # back into the link under it. Worked out once, not per movement.
    LINKMAP=()
    local lidx lstart lend luri
    while IFS=$'\t' read -r lidx lstart lend luri; do
        [ -n "$lidx" ] || continue
        LINKMAP[$lidx]="${LINKMAP[$lidx]:-}${lstart}:${lend}:${luri}"$'\x1f'
    done < <(python3 "$LIB/mdnav_links.py" "$work/buffer.ansi" 2>/dev/null)

    LINK_COUNT="$(link_count)"
    LAST_MTIME="$(file_mtime)"
    top=0
    recalc
    # The place the link named, now that the document naming it is loaded.
    if [ -n "$PENDING_ANCHOR" ]; then
        goto_anchor "$PENDING_ANCHOR" || :
        PENDING_ANCHOR=""
    fi
    # A search outlives the document it was typed in, as it does in less.
    [ -n "$SEARCH_PAT" ] && apply_search
    return 0
}

load_lines() {
    BUF=()
    local line
    while IFS= read -r line; do
        BUF+=("$line")
    done < "$1"
    recalc
}

load_hl() {
    HLBUF=()
    local line
    while IFS= read -r line; do
        HLBUF+=("$line")
    done < "$1"
}

# Runs SEARCH_PAT over the buffer, swapping in the copy with matches
# highlighted. 0: matched. 1: nothing matched. 2: the pattern is not valid.
apply_search() {
    local out ln oc
    MATCH_LINE=()
    MATCH_OCC=()
    ACTIVE_MATCH=-1
    ACTIVE_OCC=-1
    ACTIVE_RENDER=""
    MATCH_POS=-1
    HLBUF=()
    if [ -z "$SEARCH_PAT" ]; then
        return 0
    fi
    if out="$(python3 "$LIB/mdnav_search.py" "$work/buffer.ansi" "$work/buffer.hl" \
                "$SEARCH_PAT" 1 2>/dev/null)"; then
        while read -r ln oc; do
            [ -n "$ln" ] || continue
            MATCH_LINE+=("$ln")
            MATCH_OCC+=("$oc")
        done <<< "$out"
        if [ ${#MATCH_LINE[@]} -gt 0 ]; then
            [ "$HILITE" = none ] || load_hl "$work/buffer.hl"
            return 0
        fi
        HLBUF=()
        return 1
    fi
    HLBUF=()
    return 2
}

# Which match we are on is tracked as a position in the list, not as a
# scroll offset. The two part company at the end of a document: the view
# cannot scroll past the last screenful, so several matches can share the
# same top, and stepping by scroll offset gets stuck on the first of them.
set_match() {
    local pos="$1" len=${#MATCH_LINE[@]}
    [ "$len" -gt 0 ] || return 1
    [ "$pos" -lt 0 ] && pos=$(( len - 1 ))
    [ "$pos" -ge "$len" ] && pos=0
    MATCH_POS="$pos"
    ACTIVE_MATCH="${MATCH_LINE[$pos]}"
    ACTIVE_OCC="${MATCH_OCC[$pos]}"
    ACTIVE_RENDER=""
    # The line holding the current match is rendered on its own, because
    # which match you are on is a property of the occurrence, not the line:
    # under -g only that one is marked, and otherwise it is the one wearing
    # the underline while its neighbours keep plain reverse video.
    local mode=""
    case "$HILITE" in
        current) mode=only ;;
        all)     mode=emph ;;
    esac
    if [ -n "$mode" ]; then
        if python3 "$LIB/mdnav_search.py" "$work/buffer.ansi" "$work/active.line" \
               "$SEARCH_PAT" 1 "$ACTIVE_MATCH" "$ACTIVE_OCC" "$mode" 2>/dev/null; then
            # read reports failure at EOF when the file ends without a
            # newline, which this one does -- the value is still assigned.
            IFS= read -r ACTIVE_RENDER < "$work/active.line" || :
        fi
    fi
    top="$ACTIVE_MATCH"
    [ "$top" -gt "$MT" ] && top="$MT"
    return 0
}

# Where a freshly typed search lands: the first match beyond the view.
match_from_view() {
    local dir="$1" i idx=0 pos=-1
    [ ${#MATCH_LINE[@]} -gt 0 ] || return 1
    if [ "$dir" = 1 ]; then
        for i in "${MATCH_LINE[@]}"; do
            if [ "$i" -gt "$top" ]; then pos="$idx"; break; fi
            idx=$(( idx + 1 ))
        done
        [ "$pos" -lt 0 ] && pos=0
    else
        for i in "${MATCH_LINE[@]}"; do
            [ "$i" -lt "$top" ] && pos="$idx"
            idx=$(( idx + 1 ))
        done
        [ "$pos" -lt 0 ] && pos=$(( ${#MATCH_LINE[@]} - 1 ))
    fi
    set_match "$pos"
}

# n and N: one along the list, wrapping at either end.
step_match() {
    local dir="$1"
    [ ${#MATCH_LINE[@]} -gt 0 ] || return 1
    if [ "$MATCH_POS" -lt 0 ]; then
        match_from_view "$dir"
        return $?
    fi
    if [ "$dir" = 1 ]; then
        set_match $(( MATCH_POS + 1 ))
    else
        set_match $(( MATCH_POS - 1 ))
    fi
}

# Waits for a key rather than polling past its absence: the second half of
# a two-key command, where the reader has already committed to typing one.
read_key_wait() {
    local tries=0
    while :; do
        if MDNAV_KEY_POLL=0.05 mdnav_read_key; then
            case "$KEY" in
                # The mouse moving is not the rest of the command. With
                # motion reporting on it arrives constantly, and taking the
                # first thing that turned up meant : almost never saw the
                # key typed after it.
                motion|ignore) : ;;
                *) return 0 ;;
            esac
        fi
        tries=$(( tries + 1 ))
        [ "$tries" -gt 200 ] && return 1
    done
}

# The prompt is edited here rather than by the terminal, because less's
# behaviour is not the terminal's: escape abandons the search, and so does
# rubbing out the last character of it. Returns 1 when abandoned.
read_pattern() {
    local prompt="$1" row="${2:-$rows}" buf="" c seq
    PATTERN=""
    printf '\e[?25h'
    while :; do
        printf '\e[%d;1H\e[K%s%s' "$row" "$prompt" "$buf"
        IFS= read -rsn1 c || { printf '\e[?25l'; return 1; }
        case "$c" in
            "")               # return: the delimiter is stripped, leaving nothing
                PATTERN="$buf"; printf '\e[?25l'; return 0 ;;
            $'\x03')           # interrupt
                printf '\e[?25l'; return 1 ;;
            $'\e')
                # Escape itself abandons the search -- but the terminal also
                # sends escape sequences unbidden while the prompt is up:
                # wheel events, arrow keys. Those get swallowed, not typed
                # into the pattern and not mistaken for the key.
                if IFS= read -rsn1 -t 0.02 seq; then
                    if [ "$seq" = "[" ] || [ "$seq" = "O" ]; then
                        while IFS= read -rsn1 -t 0.02 seq; do
                            case "$seq" in [A-Za-z~]) break ;; esac
                        done
                    fi
                    continue
                fi
                printf '\e[?25l'; return 1 ;;
            $'\x7f'|$'\b')
                # Backing out of an empty pattern abandons it, as in less.
                if [ -z "$buf" ]; then printf '\e[?25l'; return 1; fi
                buf="${buf%?}" ;;
            $'\x15')           # ctrl-u: start again
                buf="" ;;
            $'\x17')           # ctrl-w: back one word
                buf="${buf% *}" ;;
            *)
                buf="$buf$c" ;;
        esac
    done
}

run_search() {   # <direction> <prompt>
    local dir="$1" rc
    if ! read_pattern "$2"; then
        SEARCH_MSG=""
        return 0
    fi
    # An empty pattern repeats the last one, which is what less does with a
    # bare / and return.
    [ -n "$PATTERN" ] && SEARCH_PAT="$PATTERN"
    [ -n "$SEARCH_PAT" ] || return 0
    SEARCH_DIR="$dir"
    apply_search; rc=$?
    case "$rc" in
        0) SEARCH_MSG=""; [ -n "$SEARCH_PAT" ] && match_from_view "$dir" ;;
        1) SEARCH_MSG="not found" ;;
        2) SEARCH_MSG="bad pattern" ;;
    esac
}

# Hand something to whatever opens things here. Backgrounded: a file
# manager or a browser can take seconds to appear, and the pager should not
# be waiting on it.
open_desktop() {
    local target="$1" win=""
    # Under WSL the handlers live on the Windows side, and xdg-open knows
    # nothing about them: a distribution installed for a terminal has no
    # desktop, so it has no idea what opens a PDF. wslview crosses over
    # properly; without it, cross over directly, which is the same trick by
    # hand. explorer.exe reports failure even when it worked, so its exit
    # status is not worth reading.
    if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
        if command -v wslview >/dev/null 2>&1; then
            wslview "$target" >/dev/null 2>&1 &
            return 0
        fi
        case "$target" in
            [a-zA-Z][a-zA-Z0-9+.-]*://*|mailto:*)
                # An address is not a path, and converting one produces a
                # filename that means nothing. Handed over as it stands.
                if command -v explorer.exe >/dev/null 2>&1; then
                    explorer.exe "$target" >/dev/null 2>&1 &
                    return 0
                fi ;;
        esac
        if command -v wslpath >/dev/null 2>&1 && command -v explorer.exe >/dev/null 2>&1; then
            win="$(wslpath -w "$target" 2>/dev/null)" || win=""
            if [ -n "$win" ]; then
                explorer.exe "$win" >/dev/null 2>&1 &
                return 0
            fi
        fi
    fi
    case "$(uname -s 2>/dev/null)" in
        Darwin)
            command -v open >/dev/null 2>&1 && open "$target" >/dev/null 2>&1 &
            return 0 ;;
    esac
    if command -v xdg-open >/dev/null 2>&1; then xdg-open "$target" >/dev/null 2>&1 &
    elif command -v gio >/dev/null 2>&1; then gio open "$target" >/dev/null 2>&1 &
    fi
}

# A place in this same document: find the heading it names and go there.
# The desktop could only read it as a file, and there is no such file.
goto_anchor() {
    local line
    line="$(python3 "$LIB/mdnav_anchor.py" "$work/links.json.anchors" "$1" \
              "$work/buffer.ansi" 2>/dev/null)" || return 1
    [ -n "$line" ] || return 1
    # Marked so the reader can see where they have landed -- the heading is
    # not always at the top, since the view cannot scroll past the end.
    ANCHOR_LINE="$line"
    top="$line"
    [ "$top" -gt "$MT" ] && top="$MT"
    return 0
}

# Reverse video over the whole line, reapplied after each reset the line
# carries of its own, so the mark survives the styling already in it.
anchor_render() {
    local l="${1//$'\e[0m'/$'\e[0m\e[7m'}"
    printf '\e[7m%s\e[0m' "$l"
}

goto() {
    local target="$1" frag=""
    [ -n "$target" ] || return 1
    # Somewhere outside this machine's files: not ours to open, and not a
    # path to be tested for existence either.
    case "$target" in
        [a-zA-Z][a-zA-Z0-9+.-]*://*|mailto:*)
            open_desktop "$target"
            return 1 ;;
    esac
    # "file.md#section": everything after the last # names a place inside
    # the file. A file whose own name holds a # is rarer than a link to a
    # section, so the split stands only if it leaves a file that exists.
    case "$target" in
        *"#"*)
            frag="${target##*#}"
            target="${target%#*}"
            if [ ! -f "$target" ] && [ ! -d "$target" ] && [ -f "$1" ]; then
                target="$1"
                frag=""
            fi ;;
    esac
    # A directory is a page here: the one inside it if it holds a README,
    # and a listing of what it contains if it does not. Which of the two is
    # settled while resolving the link, so by now it is the second.
    if [ -d "$target" ]; then
        stack+=("$current")
        current="$(page_for "$target")"
        PENDING_ANCHOR="$frag"
        return 0
    fi
    [ -f "$target" ] || return 1
    case "$target" in
        *.md|*.markdown|*.mkd) ;;
        *)  open_desktop "$target"
            return 1 ;;
    esac
    stack+=("$current")
    current="$target"
    PENDING_ANCHOR="$frag"
    return 0
}

# AVAIL: rows of document on screen. MT: the largest useful top index.
# Kept as variables rather than functions returning through $( ), which
# forks a subprocess -- six of them per keystroke, which is enough to feel.
AVAIL=1
MT=0
recalc() {
    AVAIL=$(( rows - 1 ))
    [ "$AVAIL" -lt 1 ] && AVAIL=1
    # A line can occupy several rows, so the furthest we can scroll is
    # found by walking back from the end until the tail stops fitting.
    local i="${#BUF[@]}" used=0
    MT="${#BUF[@]}"
    [ "$MT" -gt 0 ] && MT=$(( MT - 1 ))
    while [ "$i" -gt 0 ]; do
        i=$(( i - 1 ))
        used=$(( used + ${SPAN[$i]:-1} ))
        [ "$used" -gt "$AVAIL" ] && break
        MT="$i"
    done
    [ "$MT" -lt 0 ] && MT=0
}

draw_line() {   # <screen row> <buffer index>
    local srow="$1" i="$2"
    printf '\e[%d;1H\e[0m\e[K' "$srow"
    [ "$i" -lt "${#BUF[@]}" ] || return 0
    if [ "$i" = "$ANCHOR_LINE" ]; then
        anchor_render "${BUF[$i]}"
    elif [ "$i" = "$ACTIVE_MATCH" ] && [ -n "$ACTIVE_RENDER" ]; then
        printf '%s' "$ACTIVE_RENDER"
    elif [ "$HILITE" = all ] && [ "$i" -lt "${#HLBUF[@]}" ]; then
        printf '%s' "${HLBUF[$i]}"
    else
        printf '%s' "${BUF[$i]}"
    fi
}

# A page forward is wherever the last screen stopped, not a fixed number
# of lines: a screen holds fewer lines when some of them wrap.
page_forward() {
    if [ "$PAGE_NEXT" -gt "$top" ] && [ "$PAGE_NEXT" -le "$MT" ]; then
        top="$PAGE_NEXT"
    elif [ "$top" -lt "$MT" ]; then
        top="$MT"
    else
        return 1
    fi
    return 0
}

# And a page back is as far as fits above, counted the same way.
page_back() {
    [ "$top" -gt 0 ] || return 1
    local i="$top" used=0
    while [ "$i" -gt 0 ]; do
        i=$(( i - 1 ))
        used=$(( used + ${SPAN[$i]:-1} ))
        if [ "$used" -gt "$AVAIL" ]; then
            i=$(( i + 1 ))
            break
        fi
    done
    [ "$i" -eq "$top" ] && [ "$i" -gt 0 ] && i=$(( i - 1 ))
    top="$i"
    return 0
}

draw_all() {
    local avail="$AVAIL"
    local r=1 i="$top" span k
    # Synchronised update: the terminal shows the frame only once it is
    # complete, instead of letting the repaint be watched happening.
    # Terminals that do not know the mode ignore it.
    printf '\e[?2026h\e[H'
    ROWLINE=()
    while [ "$r" -le "$avail" ] && [ "$i" -lt "${#BUF[@]}" ]; do
        span="${SPAN[$i]:-1}"
        # A line that will not fit whole is left for the next screen rather
        # than drawn half on and half off.
        [ "$r" -gt 1 ] && [ $(( r + span - 1 )) -gt "$avail" ] && break
        k=0
        while [ "$k" -lt "$span" ] && [ $(( r + k )) -le "$avail" ]; do
            # Every row the line will cover is cleared first: the terminal
            # wraps it across them, and whatever was there before must not
            # show through.
            printf '\e[%d;1H\e[0m\e[K' $(( r + k ))
            ROWLINE[$(( r + k ))]="$i"
            k=$(( k + 1 ))
        done
        draw_line "$r" "$i"
        r=$(( r + span ))
        i=$(( i + 1 ))
    done
    # Anything left below the last line is blanked.
    while [ "$r" -le "$avail" ]; do
        printf '\e[%d;1H\e[0m\e[K' "$r"
        ROWLINE[$r]=-1
        r=$(( r + 1 ))
    done
    PAGE_NEXT="$i"
}

end_frame() { printf '\e[?2026l'; }

# Every movement repaints. Scrolling the region instead would be cheaper,
# but the terminal moves the text cells and leaves the sixel pixels where
# they were, so images tore into stripes as soon as anything scrolled. A
# full repaint of a screenful of strips measures around 15ms, which is well
# inside the budget for it not to matter.
# The link under a screen position, if any. Pure shell on purpose: this
# runs whenever the mouse moves, and a subprocess per movement would cost
# more than the feature is worth.
hover_at() {
    local row="$1" col="$2" idx entry item rest start end
    idx="${ROWLINE[$row]:--1}"
    [ "$idx" -ge 0 ] || { HOVER_URI=""; return 1; }
    entry="${LINKMAP[$idx]:-}"
    if [ -z "$entry" ]; then
        HOVER_URI=""
        return 1
    fi
    local IFS=$'\x1f'
    for item in $entry; do
        [ -n "$item" ] || continue
        start="${item%%:*}"
        rest="${item#*:}"
        end="${rest%%:*}"
        if [ "$col" -ge "$start" ] && [ "$col" -le "$end" ]; then
            HOVER_URI="${rest#*:}"
            return 0
        fi
    done
    HOVER_URI=""
    return 1
}

# Percent-decoding in the shell. A path is escaped on its way into a URI,
# and shown to a reader on its way out, so the bar reads as a filename
# rather than as the encoding of one.
percent_decode() {
    local s="$1" out="" hex ch
    case "$s" in *%*) ;; *) printf '%s' "$s"; return ;; esac
    while [ -n "$s" ]; do
        case "$s" in
            *%*)
                out="$out${s%%\%*}"
                s="${s#*%}"
                hex="${s:0:2}"
                # A stray percent is a percent. Names contain them.
                if [[ "$hex" =~ ^[0-9A-Fa-f][0-9A-Fa-f]$ ]]; then
                    printf -v ch "\\x$hex"
                    out="$out$ch"
                    s="${s:2}"
                else
                    out="$out%"
                fi ;;
            *)  out="$out$s"; s="" ;;
        esac
    done
    printf '%s' "$out"
}

# What a target is worth showing as: the scheme and the instance are
# plumbing, and an anchor reads better as the # it was written with.
hover_text() {
    local uri="$1"
    case "$uri" in
        "$SCHEME://"*)
            uri="${uri#"$SCHEME://"}"
            uri="${uri#*/}"
            uri="$(percent_decode "$uri")"
            # The bar separator between an anchor and the item under it.
            uri="${uri//|/ }"
            case "$uri" in
                "#"*) ;;
                *) uri="/$uri" ;;
            esac ;;
    esac
    printf '%s' "$uri"
}

# Following the link under a click, without the terminal in the middle.
# mdnav knows where the links are and is being told where the mouse is, so
# a plain click is enough -- no modifier, and none of the confirmation the
# terminal raises when it is the one asked to open something.
# Set by follow_click: whether the click stayed in this document or
# opened another. Reported rather than worked out again from the URI --
# both kinds carry an anchor now, and only the caller knows that a
# document it has not left does not need reloading.
FOLLOW_KIND=""

follow_click() {
    local row="$1" col="$2" uri rest
    FOLLOW_KIND=""
    hover_at "$row" "$col" || return 1
    uri="$HOVER_URI"
    [ -n "$uri" ] || return 1
    case "$uri" in
        "$SCHEME://"*)
            rest="${uri#"$SCHEME://"}"
            rest="${rest#*/}"                 # drop the instance
            rest="${rest//%23/#}"
            rest="${rest//%7C/|}"
            case "$rest" in
                "#"*)
                    FOLLOW_KIND="anchor"
                    goto_anchor "$rest" && return 0
                    return 1 ;;
                *)
                    # Decoded properly rather than by substitution: a path
                    # may hold a percent sign of its own.
                    rest="$(python3 -c 'import sys,urllib.parse as u;print(u.unquote(sys.argv[1]))' "$rest" 2>/dev/null)"
                    [ -n "$rest" ] || return 1
                    FOLLOW_KIND="file"
                    goto "/$rest" && return 0
                    return 1 ;;
            esac ;;
        *)
            # Somewhere outside this document: the desktop knows what to do
            # with it and mdnav does not.
            open_desktop "$uri"
            return 1 ;;
    esac
}

status() {
    local n pos total avail left right pad
    n="$LINK_COUNT"
    total="${#BUF[@]}"
    avail=$(( rows - 1 ))
    if [ "$total" -le "$avail" ]; then pos="all"
    elif [ "$top" -le 0 ]; then pos="top"
    elif [ "$top" -ge "$MT" ]; then pos="end"
    else pos="$(( top * 100 / (total - avail) ))%"
    fi

    left=" ${current##*/}  ${pos}  ${n} link(s)"
    if [ -n "$SEARCH_MSG" ]; then
        left="$left  /${SEARCH_PAT}: ${SEARCH_MSG}"
    elif [ -n "$SEARCH_PAT" ] && [ "$MATCH_POS" -ge 0 ]; then
        left="$left  /${SEARCH_PAT} [$(( MATCH_POS + 1 ))/${#MATCH_LINE[@]}]"
        [ "$HILITE" = all ] || left="$left -${HILITE}"
    elif [ -n "$SEARCH_PAT" ]; then
        left="$left  /${SEARCH_PAT} (${#MATCH_LINE[@]})"
    fi
    right="click a link"
    [ ${#stack[@]} -gt 0 ] && right="$right · p back"
    right="$right · l list · q quit "

    if [ -n "$HOVER_URI" ]; then
        # The target gets the bar to itself. It is routinely longer than
        # what it replaces, and sharing the width pushed the bar into its
        # narrow form -- which drops the left side, and with it the target
        # that was the whole point of pointing at the link.
        local shown; shown="$(hover_text "$HOVER_URI")"
        # Four columns for the arrow and one kept clear at the end: a
        # target trimmed to the exact width leaves no gap, and a bar with
        # no gap falls back to its narrow form, which drops the target.
        local room=$(( cols - 5 ))
        if [ "$room" -gt 1 ] && [ "${#shown}" -gt "$room" ]; then
            # Trimmed from the front: the end of a path says more than its
            # beginning does.
            shown="…${shown: -$(( room - 1 ))}"
        fi
        left=" -> ${shown}"
        right=""
    fi

    pad=$(( cols - ${#left} - ${#right} ))
    printf '\e[%d;1H\e[0m\e[K' "$rows"
    if [ "$pad" -lt 1 ] && [ -n "$right" ]; then
        printf '\e[0m\e[7m%-*.*s\e[0m' "$cols" "$cols" " $right"
    elif [ "$pad" -lt 1 ]; then
        # No hints to fall back on -- keep the left side and let the width
        # cut it, rather than showing an empty bar.
        printf '\e[0m\e[7m%-*.*s\e[0m' "$cols" "$cols" "$left"
    else
        printf '\e[0m\e[7m%s%*s%s\e[0m' "$left" "$pad" "" "$right"
    fi
    end_frame
}

if [ "$cat_mode" = 1 ]; then
    SLICE=0
    # No running instance to receive a click, so links stay plain paths.
    SCHEME=""
    rewrite
    if [ -n "$IMAGE_PROTOCOL" ]; then
        "$MDCAT" --image-protocol "$IMAGE_PROTOCOL" "$work/render.md" && exit 0
    fi
    exec "$MDCAT" "$work/render.md"
fi

rm -f "$FIFO"
mkfifo -m 600 "$FIFO" || die "could not create $FIFO"
owns_fifo=1
exec 3<>"$FIFO"

stty_saved="$(stty -g 2>/dev/null || true)"
raw_mode
query_cell_size

# 1049: own the screen, so the view can start at the top and stay put.
# 8452: leave the cursor beside a sixel rather than below it, so a strip
#       occupies its row and nothing else.
# 1000/1006: real wheel events, so a notch can move as far as the platform
#       says it should -- alternate scroll collapses one to a single arrow
#       and loses the setting. Terminals still handle ctrl+click on
#       hyperlinks while reporting is on; MDNAV_MOUSE=0 falls back to
#       alternate scroll (1007) for any that do not.
# Three lines per notch: what toolkits and terminals overwhelmingly use.
# Windows records a preference for this and X11 and macOS do not, but
# reading it meant an interop call on every launch for a value that is
# almost always three anyway. MDNAV_WHEEL_LINES overrides; -1 means a
# screen at a time.
WHEEL_LINES="${MDNAV_WHEEL_LINES:-3}"
if [ "${MDNAV_MOUSE:-1}" = 1 ]; then
    printf '\e[?1049h\e[?8452h\e[?1003h\e[?1006h'
    # -S: the terminal stops wrapping, so a long line runs off the edge
    # rather than continuing on the next row.
    [ "$CHOP" = 1 ] && printf '\e[?7l'
else
    printf '\e[?1049h\e[?8452h\e[?1007h'
fi
alt=1
printf '\e[?25l'

resized=0
trap 'resized=1' WINCH

load_buffer
draw_all
status

while :; do
    if [ "$resized" = 1 ]; then
        resized=0
        keep="$top"
        load_buffer
        top="$keep"
        recalc
        [ "$top" -gt "$MT" ] && top="$MT"
        draw_all
        status
        continue
    fi

    if read -t 0 -u 3 2>/dev/null && IFS= read -r -u 3 clicked; then
        case "$clicked" in
            "#"*)
                # Somewhere in this document rather than another file.
                if goto_anchor "$clicked"; then
                    draw_all
                    status
                fi
                continue ;;
        esac
        if goto "$clicked"; then
            load_buffer
            draw_all
            status
        fi
        continue
    fi

    # Re-render when the file changes underneath, roughly twice a second --
    # often enough to feel immediate while writing, seldom enough that the
    # stat costs nothing.
    if [ "${MDNAV_WATCH:-1}" = 1 ] && [ -n "$STAT_FLAG" ]; then
        WATCH_TICK=$(( WATCH_TICK + 1 ))
        if [ "$WATCH_TICK" -ge 16 ]; then
            WATCH_TICK=0
            now="$(file_mtime)"
            if [ -n "$now" ] && [ -n "$LAST_MTIME" ] && [ "$now" != "$LAST_MTIME" ]; then
                keep="$top"
                load_buffer
                top="$keep"
                [ "$top" -gt "$MT" ] && top="$MT"
                draw_all; status
            fi
        fi
    fi

    mdnav_read_key || continue
    avail="$AVAIL"
    mt="$MT"

    # Movement is accumulated before anything is drawn. One notch of the
    # wheel arrives as several arrow keys, and repainting per key means the
    # display runs behind the input by however far it has fallen -- which
    # reads as scrolling being slow, rather than as frames being wasted.
    delta=0
    moved=0
    while :; do
        case "$KEY" in
            down|char:j)       delta=$(( delta + 1 )); moved=1 ;;
            up|char:k)         delta=$(( delta - 1 )); moved=1 ;;
            wheel-down)
                if [ "$WHEEL_LINES" -lt 0 ]; then delta=$(( delta + avail ))
                else delta=$(( delta + WHEEL_LINES )); fi
                moved=1 ;;
            motion)
                # Redrawn only when the answer changes: the mouse reports
                # every pixel it crosses, and the bar must not be rewritten
                # that often.
                before="$HOVER_URI"
                hover_at "$MOUSE_ROW" "$MOUSE_COL" || :
                [ "$HOVER_URI" != "$before" ] && status
                : ;;
            wheel-up)
                if [ "$WHEEL_LINES" -lt 0 ]; then delta=$(( delta - avail ))
                else delta=$(( delta - WHEEL_LINES )); fi
                moved=1 ;;

            motion)
                before="$HOVER_URI"
                hover_at "$MOUSE_ROW" "$MOUSE_COL" || :
                [ "$HOVER_URI" != "$before" ] && status
                : ;;
            *) break ;;
        esac
        KEY=""
        MDNAV_KEY_POLL=0.005 mdnav_read_key || break
    done

    if [ "$moved" = 1 ]; then
        ANCHOR_LINE=-1
        new=$(( top + delta ))
        [ "$new" -lt 0 ] && new=0
        [ "$new" -gt "$mt" ] && new="$mt"
        if [ "$new" -ne "$top" ]; then
            top="$new"
            draw_all; status
        fi
    fi

    case "$KEY" in
        char:0|char:1|char:2|char:3|char:4|char:5|char:6|char:7|char:8|char:9|char:g|char:G|home|end) : ;;
        *) COUNT="" ;;
    esac

    case "$KEY" in
        space|pgdn|char:f)
            if page_forward; then ANCHOR_LINE=-1; draw_all; status; fi ;;
        pgup|char:u|char:b)
            if page_back; then ANCHOR_LINE=-1; draw_all; status; fi ;;
        click)
            if follow_click "$MOUSE_ROW" "$MOUSE_COL"; then
                case "$FOLLOW_KIND" in
                    anchor) draw_all; status ;;     # a place in this document
                    *)      # The mouse has not moved, but what is under it
                            # has: describing the link just left would be
                            # describing something no longer there.
                            HOVER_URI=""
                            load_buffer; draw_all; status ;;
                esac
            fi ;;
        char:/)
            run_search 1 "/"
            draw_all; status ;;
        "char:?")
            run_search -1 "?"
            draw_all; status ;;
        char:n)
            if [ -n "$SEARCH_PAT" ]; then
                SEARCH_MSG=""
                step_match "$SEARCH_DIR" || SEARCH_MSG="not found"
                draw_all; status
            fi ;;
        char:N)
            if [ -n "$SEARCH_PAT" ]; then
                SEARCH_MSG=""
                step_match $(( SEARCH_DIR * -1 )) || SEARCH_MSG="not found"
                draw_all; status
            fi ;;
        escape)
            if [ -n "$SEARCH_PAT" ]; then
                SEARCH_PAT=""; SEARCH_MSG=""
                MATCH_LINE=(); MATCH_OCC=()
                ACTIVE_MATCH=-1; ACTIVE_OCC=-1; ACTIVE_RENDER=""; MATCH_POS=-1
                apply_search
                draw_all; status
            fi ;;
        char:0|char:1|char:2|char:3|char:4|char:5|char:6|char:7|char:8|char:9)
            COUNT="$COUNT${KEY#char:}"
            printf '\e[%d;1H\e[K:%s' "$rows" "$COUNT" ;;
        home|char:g)
            if [ -n "$COUNT" ]; then
                top=$(( COUNT - 1 ))
                [ "$top" -lt 0 ] && top=0
                [ "$top" -gt "$mt" ] && top="$mt"
            else
                top=0
            fi
            COUNT=""; SEARCH_MSG=""
            draw_all; status ;;
        end|char:G)
            if [ -n "$COUNT" ]; then
                top=$(( COUNT - 1 ))
                [ "$top" -lt 0 ] && top=0
                [ "$top" -gt "$mt" ] && top="$mt"
            else
                top="$mt"
            fi
            COUNT=""; SEARCH_MSG=""
            draw_all; status ;;
        char:r)
            load_buffer; draw_all; status ;;
        backspace|char:p)
            if [ ${#stack[@]} -gt 0 ]; then
                last=$(( ${#stack[@]} - 1 ))
                current="${stack[$last]}"; unset "stack[$last]"
                load_buffer; draw_all; status
            fi ;;
        char:l|char:L)
            printf '\e[H\e[2J'
            listing="$(list_links)"
            printf '%s\n' "$listing"
            # Asked for just under the list, rather than at the foot of a
            # mostly empty screen.
            prompt_row=$(( $(printf '%s\n' "$listing" | wc -l) + 2 ))
            [ "$prompt_row" -gt "$rows" ] && prompt_row="$rows"
            # Read here rather than in the terminal: with the mouse
            # reporting, every movement would otherwise be typed into the
            # prompt as an escape sequence.
            read_pattern "follow link #: " "$prompt_row" || PATTERN=""
            num="$PATTERN"
            if [ -n "${num//[!0-9]/}" ]; then
                target="$(link_path "$num")"
                case "$target" in
                    "#"*) goto_anchor "$target" || : ;;
                    *)    goto "$target" && load_buffer ;;
                esac
            fi
            draw_all; status ;;
        "char::")
            # In less, : is a prefix: the command runs on the next key, with
            # no return to press. Show it while that key is awaited, so the
            # prefix is visibly pending rather than swallowed.
            printf '\e[%d;1H\e[K:' "$rows"
            if read_key_wait; then
                case "$KEY" in
                    char:q|char:x) break ;;
                    char:p)
                        if [ ${#stack[@]} -gt 0 ]; then
                            last=$(( ${#stack[@]} - 1 ))
                            current="${stack[$last]}"; unset "stack[$last]"
                            load_buffer
                            SEARCH_MSG=""
                        else
                            SEARCH_MSG="no previous file"
                        fi ;;
                    escape) SEARCH_MSG="" ;;
                    *) SEARCH_MSG="no such command" ;;
                esac
                draw_all; status
            fi ;;
        char:q|char:Q)
            break ;;
    esac
done
